{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Verio",
  "version": "0.2.1",
  "identifier": "ir.verio.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Verio",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "startMenuFolder": "Verio",
        "uninstallerIcon": "icons/icon.ico",
        "uninstallerHeaderImage": "icons/nsis-header.bmp"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzNTk3QTNEQTMzRTdGNzAKUldSd2Z6NmpQWHBaZzE2NDd5Ry8weUg1THU3MXRVT1JkclRIditiQlJaZkEwNm5RTGV4Yk9rcjIK",
      "endpoints": [
        "https://update.verio.drfake.ir:9443/latest.json",
        "https://github.com/MahanTaqipour/verio/releases/latest/download/latest.json"
      ]
    }
  }
}
