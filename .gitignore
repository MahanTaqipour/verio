.idea/
*.swp
*.swo
*~
.workbuddy-ai/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Secrets / local config — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
signing/
settings.json

# Tauri updater signing keys
*.key.pub
tauri.key
tauri.key.pub

# Design / temp working files (not source)
/design/
.openclaw/
.openclaw
*.tmp
*.bak
*_done.flag
/verio-music-player-panel.zip
/verio.exe

# Debug audio dumps; retain shipping sound assets
*.wav
# The earcons are compiled into the binary with include_bytes! from
# crates/verio-dsp/src/earcon.rs, so this path is load-bearing: if it is not
# tracked, a clean checkout fails to build rather than shipping without cues.
!crates/verio-dsp/assets/sounds/*.wav
!ui/public/**/*.wav
